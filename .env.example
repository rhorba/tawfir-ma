# Tawfir.ma — environment variables
# Copy to .env and fill in real values for your environment. Never commit .env.
# See docs/devops-tawfir.md §7 for the full variable contract and purpose of each.

# --- Database ---
DATABASE_URL=jdbc:postgresql://localhost:5432/tawfir
DATABASE_USER=tawfir
DATABASE_PASSWORD=tawfir_dev_password

# --- Auth / JWT (ADR-3) ---
JWT_SIGNING_KEY=dev-only-change-me-before-any-shared-environment
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# --- OTP / SMS provider ---
# Provider still undecided (see security-tawfir.md §3). For local dev, Sprint 2 uses
# a mock OTP service that logs the code to the console instead of sending a real SMS.
OTP_PROVIDER=mock
OTP_PROVIDER_API_KEY=mock-not-used-by-mock-provider

# --- Notifications (organizer/member alerts: late contributions, payouts needing review) ---
# Provider still undecided, same as OTP_PROVIDER above. For local dev/CI, a mock provider
# logs the message to the console instead of sending a real SMS/push/email.
NOTIFICATION_PROVIDER=mock

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200

# --- PII encryption (database-tawfir.md §7) ---
# Also used, as of Sprint 5 Batch 1, to AES-GCM encrypt the admin TOTP secret at rest
# (AesGcmEncryptor) — see security-tawfir.md §3. Same key, no separate var needed.
PII_ENCRYPTION_KEY=dev-only-change-me-before-any-shared-environment

# --- CMI payments (not used until Sprint 4 — mocked until then) ---
CMI_PROVIDER=mock
CMI_WEBHOOK_SECRET=mock-webhook-secret
CMI_API_KEY=mock-not-used-by-mock-provider
